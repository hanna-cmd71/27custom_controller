{
    // 使用 IntelliSense 了解相关属性。 
    // 悬停以查看现有属性的描述。
    // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "无线DAP Debug",
            "cwd": "${workspaceFolder}",
            "executable": "E:\\rm\\8\\standard-robot-pro\\MDK-ARM\\build\\Keil\\StandardRobotPro.axf", 
            // 含有调试信息的可执行文件的路径，可以是 keil 生成的 .axf 文件 
            // 或者 ARM-GNU-toolchain 生成的 .elf 文件
            "request": "launch", // 启动类型，常用launch
            "type": "cortex-debug", // 调试器类型不可动
            "runToEntryPoint": "main",
            "servertype": "openocd", 
            // gdb server类型，
            // 常用为jlink，stlink，openocd等
            /*
            * OpenOCD 配置文件在安装目录的 scripts 目录下
            * 其中：
            * interface 目录里包含了所有受支持的 硬件调试器 对应的配置文件
            * target 目录包含了所有受支持的 芯片系列 对应的配置文件
            */
            "configFiles": [    
                "interface/cmsis-dap.cfg",
                "target/stm32f4x.cfg"
            ],
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
        },
        {
            "name": "STLink Debug",
            "cwd": "${workspaceFolder}",
            "executable": "E:\\rm\\engineer\\new_remoto\\MDK-ARM\\build\\Keil\\StandardRobotPro.axf", 
            // 含有调试信息的可执行文件的路径，可以是 keil 生成的 .axf 文件 
            // 或者 ARM-GNU-toolchain 生成的 .elf 文件
            "request": "launch", // 启动类型，常用launch
            "type": "cortex-debug", // 调试器类型不可动
            "runToEntryPoint": "main",
            "servertype": "openocd", 
            // gdb server类型，
            // 常用为jlink，stlink，openocd等
            /*
            * OpenOCD 配置文件在安装目录的 scripts 目录下
            * 其中：
            * interface 目录里包含了所有受支持的 硬件调试器 对应的配置文件
            * target 目录包含了所有受支持的 芯片系列 对应的配置文件
            */
            "configFiles": [    
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ],
                       // 用 .hex 烧录，绕开 GNU gdb 对 Keil .elf 的 "RW_IRAM1 outside of ELF segments"
            // 导致段被跳过、固件下载不完整的问题；.elf 仅用于提供调试符号
            "loadFiles": [
                "E:\\rm\\engineer\\remoto2\\standard-robot-pro\\MDK-ARM\\build\\Keil\\StandardRobotPro.hex"
            ],
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
        }
    ]
}